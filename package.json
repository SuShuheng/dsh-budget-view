{
  "name": "dsh-budget-view",
  "version": "0.5.0",
  "description": "DSH 插件：支持 Magpie 与原生 Codex / OpenCode Go 额度、DeepSeek 余额、波峰/波谷状态及会话费用估算。",
  "type": "module",
  "main": "index.js",
  "private": false,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "verify-client.mjs",
    "verify-host.mjs",
    "verify-magpie.mjs"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check verify-client.mjs && node --check verify-host.mjs && node --check verify-magpie.mjs",
    "test": "node verify-client.mjs && node verify-host.mjs && node verify-magpie.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuShuheng/dsh-budget-view.git"
  },
  "homepage": "https://github.com/SuShuheng/dsh-budget-view#readme",
  "bugs": {
    "url": "https://github.com/SuShuheng/dsh-budget-view/issues"
  },
  "author": "SuShuheng",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-plugins",
    "budget",
    "usage",
    "cost",
    "codex",
    "magpie",
    "opencode-go",
    "deepseek",
    "token"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
